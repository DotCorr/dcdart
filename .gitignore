# Dart / Pub
.dart_tool/
.packages
build/
pubspec.lock

# Compiled build artifacts from example/conformance targets (regenerated by
# run.sh into a temp workdir normally; a few stray ones exist in-tree from
# manual runs during development)
*.o
*.dill
*.ll

# Vendored dart-lang/sdk sparse clone (core/frontend/vendor/dart-sdk/) — ~245MB
# including its own nested .git history. Reproducible exactly via the pinned
# clone command in docs/decisions/0005-vendor-dart-sdk-frontend.md and
# docs/decisions/0007-detach-vendored-frontend-from-sdk-workspace.md; not
# committed here to keep this repo's size and history sane.
# Both forms deliberately: the trailing-slash rule matches only a real
# directory, NOT a symlink — and a fresh worktree's standard move is to
# symlink the vendored SDK from the main checkout. Without the second rule
# that symlink shows untracked and a stray `git add -A` commits an absolute
# local path into the repo (found by dc-sys-21's agent, 2026-08-28).
core/frontend/vendor/
core/frontend/vendor

# OS / editor
.DS_Store
Thumbs.db

# Claude Code local session state
.claude/

# Internal agent-orchestration process docs — kept locally, not published.
# Root of the public repo is intentionally just README.md + core/.
/AGENTS.md
/CLAUDE.md
/DCDART_SPEC.md
/ROADMAP.md
/SKILL.md

# Private sub-agent skill packages, copied in by dcdart-internal's sync.sh
# (which writes them to mnt/user-data/outputs/dcdart/skills/). They are
# tracked only in the private dcdart-internal repo; without this rule a
# `git add -A` after a sync would publish them here.
/mnt/
